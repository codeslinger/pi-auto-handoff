{
	"name": "@codeslinger001/pi-auto-handoff",
	"version": "0.1.2",
	"description": "Threshold-triggered handoff compaction for the Pi coding agent (ports omp's auto-handoff method)",
	"type": "module",
	"main": "src/auto-handoff.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeslinger/pi-auto-handoff.git"
	},
	"author": "Toby DiPasquale <toby@cbcg.net>",
	"files": [
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./src/auto-handoff.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"compaction",
		"handoff"
	],
	"license": "MIT",
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	}
}
